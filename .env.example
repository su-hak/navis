# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Model Configuration
MODEL_NAME=claude-3-5-sonnet-20241022
TEMPERATURE=0.7
MAX_TOKENS=4096

# Agent Configuration
AGENT_NAME=NavisAgent
AGENT_DESCRIPTION=A general-purpose AI agent powered by Claude

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Allowed user IDs (comma-separated). Leave empty to allow all users.
# Example: 123456789,987654321
ALLOWED_USER_IDS=

# AI Team Configuration
ANTHROPIC_API_KEY=your_anthropic_key_here
NEWS_API_KEY=your_news_api_key_here
# OpenAI API (선택적 - RAG embeddings용)
# OPENAI_API_KEY=your_openai_key_here

# Optional: Other API Keys
# TAVILY_API_KEY=your_tavily_key_here

# Broker API Configuration (Execution Team)
# Alpaca (Paper Trading - 테스트용)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Paper trading URL

# Alpaca (Live Trading - 실전용, 주의!)
# ALPACA_BASE_URL=https://api.alpaca.markets

# Interactive Brokers (향후 추가)
# IBKR_HOST=127.0.0.1
# IBKR_PORT=7497
# IBKR_CLIENT_ID=1

# ============================================
# Auto Trading Bot V2 Configuration
# ============================================

# 자동매매 활성화 (주의: true로 설정 시 실제 주문 실행!)
AUTO_TRADING_ENABLED=false

# [Stage 1] 전체 시장 스캔 설정
MARKET_SCAN_INTERVAL_MINUTES=5      # 시장 스캔 주기 (분) - 기획서: 3~5분
GAP_THRESHOLD=3.0                    # 갭 임계값 (%) - 기획서: 3%
VOLUME_RATIO_THRESHOLD=3.0           # 거래량 비율 임계값 - 기획서: 3배
MAX_WATCHLIST_SIZE=20                # 워치리스트 최대 크기 - 기획서: 20개

# [Stage 2] 고주기 모니터링 설정
MONITOR_INTERVAL_SECONDS=10          # 모니터링 간격 (초) - 기획서: 5~10초
PRICE_CHANGE_THRESHOLD=1.5           # 가격 변동 임계값 (%) - 기획서: 1.5%

# 리스크 관리 (기획서 10. 리스크 관리)
MAX_INVESTMENT_PERCENT=10.0          # 1회 최대 투자 비율 (%) - 기획서: 10%
STOP_LOSS_PERCENT=2.0                # 손절 비율 (%) - 기획서: 2%
MAX_DAILY_LOSS_PERCENT=5.0           # 일일 최대 손실 비율 (%) - 기획서: 5%
MAX_POSITIONS=5                      # 최대 동시 보유 종목 수
# !! TAKE_PROFIT_PERCENT 는 .env 에서 설정하지 말 것 !!
# TP/SL 수치 변경은 반드시 config/trading_constants.py 에서만 수행한다.
# .env 를 통한 오버라이드는 백테스트(constants 기준)와 라이브(env 기준) 간 TP 불일치를 유발한다.

# 멀티 전략 설정 (기획서 7. 멀티 전략 시스템)
# 전략별 포트폴리오 비중은 코드에서 설정:
# - 모멘텀: 40%
# - 돌파: 30%
# - 리버전: 30%

# Execution Team 설정
ORDER_STORAGE_PATH=logs/execution/orders
ENABLE_CIRCUIT_BREAKER=true
MAX_RETRY_ATTEMPTS=3

# Logging
EXECUTION_LOG_FILE=logs/execution/execution.log
