# ============================================================
# Strategy Engine — 환경변수 설정 예시
# Railway 대시보드 또는 로컬 .env 파일에 설정하세요.
# ============================================================

# ── 서버 설정 ─────────────────────────────────────────────
# Railway가 자동으로 PORT를 주입합니다. 직접 설정하지 마세요.
# PORT=8001

LOG_LEVEL=INFO

# ── Alpaca API (MarketGate SPY 데이터 조회용) ─────────────
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# ============================================================
# 전략 파라미터 (운영자 조정 가능 — 선택사항)
# 설정하지 않으면 config/trading_constants.py 기본값 사용.
# 수정하면 실거래 봇 + 백테스트 엔진에 동시 반영됩니다.
# ============================================================

# 진입 조건
SPIKE_TRIGGER_PCT=1.0          # 장중 스파이크 트리거 (%, 기본 1.0)
MIN_GAP_PCT=3.0                # 갭 진입 최소 기준 (%, 기본 3.0)
MIN_VOLUME_RATIO=3.0           # 거래량 배율 기준 (배, 기본 3.0)

# 청산 조건
TAKE_PROFIT_PCT=6.0            # 익절 기준 (%, 기본 6.0)
STOP_LOSS_PCT=2.0              # 손절 기준 (%, 기본 2.0)
ATR_SL_MULTIPLIER=1.5          # ATR SL 배율 (배, 기본 1.5)
PARTIAL_TP_PCT=3.0             # 분할 익절 트리거 (%, 기본 3.0)
TRAILING_STOP_PCT=2.0          # 추적 청산 비율 (%, 기본 2.0)
