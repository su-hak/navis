# Railway Deployment - Auto Trading Bot V2
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    default-libmysqlclient-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all necessary modules
COPY data_collection/ ./data_collection/
COPY execution_team/ ./execution_team/
COPY strategy_engine/ ./strategy_engine/
COPY utils/ ./utils/
COPY agents/ ./agents/
COPY tools/ ./tools/
COPY config/ ./config/
COPY auto_trading_bot_v2.py .
COPY telegram_bot.py .

# Set timezone to US Eastern (for market hours)
ENV TZ=America/New_York
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Set PYTHONPATH
ENV PYTHONPATH=/app

# Create logs directory
RUN mkdir -p /app/logs/execution/orders

# Run the V2 trading bot
CMD ["python", "-u", "auto_trading_bot_v2.py"]
